
ODIR = obj/

CFLAGS = OBJNAME $(ODIR)  DEF INTERNAL_ASYNC DEF OSVERMIN=0 DEF OSVERMAX=999 DEF GENERIC

OBJS= $(ODIR)depend.o $(ODIR)cmdlist.o $(ODIR)run.o $(ODIR)poolmem.o $(ODIR)string.o\
      $(ODIR)main.o $(ODIR)var.o $(ODIR)parse.o $(ODIR)cond.o $(ODIR)convert.o\
      $(ODIR)gethead.o $(ODIR)getpred.o $(ODIR)gettail.o $(ODIR)buffer.o $(ODIR)path.o\
      $(ODIR)console.o $(ODIR)system13.o $(ODIR)parserevh.o $(ODIR)AsyncR_SDMake.o\
      $(ODIR)OpenAsync.o $(ODIR)SeekAsync.o $(ODIR)CloseAsync.o $(ODIR)ReadLineAsync.o\
      $(ODIR)ReadCharAsync.o $(ODIR)FGetsLenAsync.o $(ODIR)SendPacket.o $(ODIR)WaitPacket.o

bin/sdmake: $(OBJS)
   sc $(CFLAGS) link to bin/sdmake with <<
$(OBJS)
<

clean:
   -delete $(OBJS)
   -delete bin/sdmake


