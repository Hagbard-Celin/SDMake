
.ifdef bootstrap
SDMAKE = bin/sdmake
.else
SDMAKE = sdmake
.endif

Types = OSv34 OSv36 OSv37 OSv39

.ifgt $(HOST_OSVER) 38
NATIVE = OSv39
.else
.ifgt $(HOST_OSVER) 35
NATIVE = OSv36
.else
.ifgt $(HOST_OSVER) 36
NATIVE = OSv37
.else
NATIVE = OSv34
.endif
.endif
.endif

.leftislabel

native: $(NATIVE)

.ifdef INSTALL
$(Types)::
    $(SDMAKE) -f SDMakefile.main -DTYPE=%(left) -DOSVERMIN=%(left:OSv*:*) -DOSVERMAX=%(left:OSv*:*) bootstrap
.else
$(Types)::
    $(SDMAKE) -f SDMakefile.main -DTYPE=%(left) -DOSVERMIN=%(left:OSv*:*) -DOSVERMAX=%(left:OSv*:*)
.endif

Generic:
    $(SDMAKE) -f SDMakefile.main -DGENERIC
    $(SDMAKE) -f SDMakefile.main -DINTERNAL_ASYNC=0 -DGENERIC

all: $(Types) Generic


