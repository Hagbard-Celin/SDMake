PROJECT= SDMake
.include SDMakefile.config

OSVERMIN ?= 0
OSVERMAX ?= 999

INTERNAL_ASYNC ?= 1

ASYNCDIR= asyncio/src/

SRCS= depend.c cmdlist.c run.c poolmem.a string.c main.c var.c parse.c cond.c \
      convert.c gethead.a getpred.a gettail.a buffer.c path.c parserevh.c async.c

.ifgt 36 $(OSVERMIN)
SRCS= $(SRCS) console.c system13.c
.endif

.ifgt 1 $(INTERNAL_ASYNC)
ASYNCSRCS=$(ASYNCDIR)AsyncLib.c $(ASYNCDIR)AsyncLibVer.c
.else
ASYNCSRCS=$(ASYNCDIR)OpenAsyncFH.c $(ASYNCDIR)OpenAsync.c $(ASYNCDIR)SeekAsync.c \
      $(ASYNCDIR)ReadAsync.c $(ASYNCDIR)CloseAsync.c $(ASYNCDIR)FGetsLenAsync.c \
      $(ASYNCDIR)ReadCharAsync.c $(ASYNCDIR)RecordAsyncFailure.c $(ASYNCDIR)SendPacket.c \
      $(ASYNCDIR)WaitPacket.c $(ASYNCDIR)RequeuePacket.c
.endif

GUIDE= sdmake.guide

.ifdef TYPE
CFLAGS = DEF TYPE="$(TYPE)"
.else
CFLAGS = DEF GENERIC
TYPE = Generic
.endif

.ifgt 1 $(INTERNAL_ASYNC)
BD= build/$(TYPE)-needs_asyncio.library/
.else
BD= build/$(TYPE)-asyncio_integrated/
.endif

OD= $(BD)obj/
EXEDIR= $(BD)bin/
CFLAGS= OBJNAME $(OD) DEF OSVERMIN=$(OSVERMIN) DEF OSVERMAX=$(OSVERMAX) $(CFLAGS)

.ifgt 1 $(INTERNAL_ASYNC)
.else
CFLAGS= DEF INTERNAL_ASYNC $(CFLAGS)
.endif

.ifdef USE_DEBUG
CFLAGS= DEF USE_DEBUG=1 $(CFLAGS)
.endif

EXE= $(EXEDIR)$(PROJECT)

OBJS= $(SRCS:"*.?":"$(OD)*.o") $(ASYNCSRCS:"$(ASYNCDIR)*.?":"$(OD)*.o")

SRCS= $(SRCS) $(ASYNCSRCS)

DIRS = $(BD:*/:*) $(OD:*/:*) $(EXEDIR:*/:*)


.leftislabel

all: $(DIRS) $(EXE)

bootstrap: all install


.leftisfile

$(DIRS) :$(DIRS)
	makedir %(left)
        copy build.info %(left).info

$(EXE): $(OBJS)
    @fwrite $(OD)$(PROJECT).lnktmp %(right)
    sc $(CFLAGS) LINK to %(left) with $(OD)$(PROJECT).lnktmp

$(OBJS) : $(SRCS)
    sc $(CFLAGS) OBJNAME %(left) %(right)

ENVARC:SDMake : ENVARC:SDMake
    makedir ENVARC:SDMake

ENVARC:SDMake/SDMake-SMake.def : ENVARC:SDMake/SDMake-SMake.def
    copy SDMake-SMake.def ENVARC:SDMake

.ifgt $(HOST_OSVER) 46
.else
ENV:SDMake : ENV:SDMake
    makedir ENV:SDMake

ENV:SDMake/SDMake-SMake.def : ENV:SDMake/SDMake-SMake.def
    copy SDMake-SMake.def ENV:SDMake

install: ENV:SDMake ENV:SDMake/SDMake-SMake.def
.endif

.ifgt $(HOST_OSVER) 39
.ifgt $(HOST_OSVER) 44
.else
HOLDBIT_NOP =
.endif
.endif

install: ENVARC:SDMake ENVARC:SDMake/SDMake-SMake.def
    protect $(EXE) H add
    copy $(EXE)(%|.info) $(INSTALLDIR)
    copy $(GUIDE) $(GUIDEDIR)
    @if defined HOLDBIT_NOP
     @echo "The hold bit does not work on this version of AmigaOS."
     @echo "Adding the following line to s:user-startup is highly recommended:"
     @echo "Resident $(INSTALLDIR)SDMake ADD"
    @endif

clean:
    -delete $(OBJS)

relink: rmexe $(EXE)

rmexe:
    -delete $(EXE)

version:
    -bumprev 2 sdmake_rev

.leftisfile

$(OD)depend.o: depend.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)path.o: path.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)cond.o: cond.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)parserevh.o: parserevh.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)cmdlist.o: cmdlist.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)string.o: string.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)run.o: run.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)main.o: main.c defs.h sdmake_rev.h tokens.h sdmake-protos.h poolmem.h
$(OD)var.o: var.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)parse.o: parse.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)convert.o: convert.c defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)buffer.o: buffer.c defs.h tokens.h sdmake-protos.h poolmem.h

