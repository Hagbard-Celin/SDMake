PROJECT= SDMake
.include SDMakefile.config

OSVERMIN ?= 0
OSVERMAX ?= 999

INTERNAL_ASYNC ?= 1

ASYNCDIR= asyncio/AsyncR/

SRCS= depend.c cmdlist.c run.c poolmem.a string.c main.c var.c parse.c cond.c \
      convert.c gethead.a getpred.a gettail.a buffer.c parserevh.c

.ifgt 36 $(OSVERMIN)
SRCS= $(SRCS) console.c system13.c
.endif

.ifgt $(OSVERMAX) 35
SRCS= $(SRCS) path.c
.endif

ASYNCSRCS=$(ASYNCDIR)AsyncR_SDMake.c $(ASYNCDIR)OpenAsync.c $(ASYNCDIR)CloseAsync.c \
      $(ASYNCDIR)SeekAsync.c $(ASYNCDIR)ReadCharAsync.c $(ASYNCDIR)SendPacket.c \
      $(ASYNCDIR)WaitPacket.c $(ASYNCDIR)FGetsLenAsync.c $(ASYNCDIR)ReadLineAsync.c

GUIDE= sdmake.guide

.ifdef TYPE
CFLAGS = DEF TYPE="$(TYPE)"
.else
CFLAGS = DEF GENERIC
TYPE = Generic
.endif

BD= build/$(TYPE)/

OD= $(BD)obj/
EXEDIR= $(BD)bin/
CFLAGS= OBJNAME $(OD) DEF OSVERMIN=$(OSVERMIN) DEF OSVERMAX=$(OSVERMAX) $(CFLAGS)


.ifdef USE_DEBUG
CFLAGS= DEF USE_DEBUG=1 $(CFLAGS)
.endif

EXE= $(EXEDIR)$(PROJECT)

OBJS= $(SRCS:"*.?":"$(OD)*.o") $(ASYNCSRCS:"$(ASYNCDIR)*.?":"$(OD)*.o")

SRCS= $(SRCS) $(ASYNCSRCS)

DIRS = $(BD:*/:*) $(OD:*/:*) $(EXEDIR:*/:*)


.leftislabel

all: $(DIRS) $(EXE)

bootstrap: all install


.leftisfile

$(DIRS) :$(DIRS)
	makedir %(left)
        copy build.info %(left).info

$(EXE): $(OBJS)
    @fwrite $(OD)$(PROJECT).lnktmp %(right)
    sc $(CFLAGS) LINK to %(left) with $(OD)$(PROJECT).lnktmp

$(OBJS) : $(SRCS)
      sc $(CFLAGS) OBJNAME %(left) %(right)

ENVARC:SDMake : ENVARC:SDMake
    makedir ENVARC:SDMake

ENVARC:SDMake/SDMake-SMake.def : ENVARC:SDMake/SDMake-SMake.def
    copy SDMake-SMake.def ENVARC:SDMake

.ifgt $(HOST_OSVER) 46
.else
ENV:SDMake : ENV:SDMake
    makedir ENV:SDMake

ENV:SDMake/SDMake-SMake.def : ENV:SDMake/SDMake-SMake.def
    copy SDMake-SMake.def ENV:SDMake

install: ENV:SDMake ENV:SDMake/SDMake-SMake.def
.endif

.ifgt $(HOST_OSVER) 39
.ifgt $(HOST_OSVER) 44
.else
HOLDBIT_NOP =
.endif
.endif

install: ENVARC:SDMake ENVARC:SDMake/SDMake-SMake.def
    protect $(EXE) H add
    copy $(EXE)(%|.info) $(INSTALLDIR)
    copy $(GUIDE) $(GUIDEDIR)
    @if defined HOLDBIT_NOP
     @echo " "
     @echo "The hold bit does not work on this version of AmigaOS."
     @echo "Adding the following line to s:user-startup is highly recommended:"
     @echo "Resident $(INSTALLDIR)SDMake ADD"
     @echo " "
    @endif

clean:
    -delete $(OBJS)

relink: rmexe $(EXE)

rmexe:
    -delete $(EXE)

version:
    -bumprev 2 sdmake_rev

.leftisfile

$(OD)depend.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)path.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)cond.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)parserevh.o: defs.h tokens.h sdmake-protos.h poolmem.h $(ASYNCDIR)include/asyncr.h $(ASYNCDIR)include/asyncr_sdmake.h
$(OD)cmdlist.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)string.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)run.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)main.o: defs.h sdmake_rev.h tokens.h sdmake-protos.h poolmem.h
$(OD)var.o:  defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)parse.o: defs.h tokens.h sdmake-protos.h poolmem.h $(ASYNCDIR)include/asyncr.h $(ASYNCDIR)include/asyncr_sdmake.h
$(OD)convert.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)buffer.o: defs.h tokens.h sdmake-protos.h poolmem.h
$(OD)AsyncR_SDMake.o: defs.h sdmake-protos.h poolmem.h $(ASYNCDIR)include/asyncr.h $(ASYNCDIR)include/asyncr_sdmake.h
$(OD)OpenAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)CloseAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)SeekAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)SendPacket.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)WaitPacket.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)ReadCharAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)FGetsLenAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h
$(OD)ReadLineAsync.o: $(ASYNCDIR)asyncr_internal.h $(ASYNCDIR)include/asyncr.h

