DIR= 
SRCS= depend.c cmdlist.c run.c main.c var.c subs.c parse.c convert.c \
gethead.a getpred.a gettail.a buffer.c path.c console.c system13.c
HDRS= defs.h tokens.h
EXTRAS= sdmake.doc
PDEFAULT= 
EXEDIR= build/bin/
OD= build/obj/
PRECOMP= defs.h
TYPE= Normal
RUN= 
CFLAGS=
