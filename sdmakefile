PROJECT= SDMake
DIR= 

OSVERMIN ?= 0
OSVERMAX ?= 999

SRCS= depend.c cmdlist.c run.c poolmem.a string.c main.c var.c parse.c cond.c \
      convert.c gethead.a getpred.a gettail.a buffer.c path.c parserevh.c

.ifgt $(OSVERMIN) 36
.else
SRCS= $(SRCS) console.c system13.c
.endif

EXTRAS= sdmake.guide
PDEFAULT= 
EXEDIR= build/bin/
OD= build/obj/
TYPE= Normal
RUN= 
CFLAGS= DEF OSVERMIN=$(OSVERMIN) DEF OSVERMAX=$(OSVERMAX)
EXE= sdmake


EXE= $(EXEDIR)$(PROJECT)

OBJS= $(SRCS:"*.?":"$(OD)*.o")

all: $(EXE)

nopro: $(EXE)

$(EXE): $(OBJS)
    fwrite $(OD)$(PROJECT).lnktmp %(right)
    sc $(CFLAGS) LINK to %(left) with $(OD)$(PROJECT).lnktmp

$(OBJS) : $(SRCS)
    sc $(CFLAGS) OBJNAME %(left) %(right)

clean:
    -delete $(OBJS)

relink: rmexe $(EXE)

rmexe:
    -delete $(EXE)

version:
    -bumprev 2 sdmake_rev


depend.o: depend.c defs.h tokens.h sdmake-protos.h poolmem.h
path.o: path.c defs.h tokens.h sdmake-protos.h poolmem.h
cond.o: cond.c defs.h tokens.h sdmake-protos.h poolmem.h
parserevh.o: parserevh.c defs.h tokens.h sdmake-protos.h poolmem.h
cmdlist.o: cmdlist.c defs.h tokens.h sdmake-protos.h poolmem.h
string.o: string.c defs.h tokens.h sdmake-protos.h poolmem.h
run.o: run.c defs.h tokens.h sdmake-protos.h poolmem.h
main.o: main.c defs.h sdmake_rev.h tokens.h sdmake-protos.h poolmem.h
var.o: var.c defs.h tokens.h sdmake-protos.h poolmem.h
parse.o: parse.c defs.h tokens.h sdmake-protos.h poolmem.h
convert.o: convert.c defs.h tokens.h sdmake-protos.h poolmem.h
buffer.o: buffer.c defs.h tokens.h sdmake-protos.h poolmem.h

